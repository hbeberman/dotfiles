[Unit]
Description=Swww Daemon (Wayland wallpaper daemon)
Documentation=https://github.com/LGFae/swww
After=niri.service
Wants=niri.service
PartOf=niri.service

[Service]
Type=simple
# Wait up to 30s for any Wayland socket to appear
ExecStartPre=/bin/bash -c 'for i in {1..300}; do SOCKET=$(find /run/user/$(id -u) -maxdepth 1 -type s -name "wayland-*"); [ -n "$SOCKET" ] && echo "Found socket: $SOCKET" && exit 0; sleep 0.1; done; echo "No Wayland socket found after timeout" >&2; exit 1'
ExecStart=/usr/bin/swww-daemon
Restart=always
TimeoutStopSec=5
RestartSec=2

Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=WAYLAND_DISPLAY=wayland-1

[Install]
WantedBy=default.target

