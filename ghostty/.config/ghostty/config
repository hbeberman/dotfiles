font-family = CascadiaMono Nerd Font
font-family-bold = CascadiaMono Nerd Font
font-family-italic = CascadiaMono Nerd Font
font-family-bold-italic = CascadiaMono Nerd Font
#font-family = Cascadia Code PL
#font-family-bold = Cascadia Code PL
#font-family-italic = Cascadia Code PL
#font-family-bold-italic = Cascadia Code PL
background = #000000
background-opacity = 0.8
command = /usr/bin/env fish
window-padding-x = 5
copy-on-select = clipboard
click-repeat-interval = 500
gtk-single-instance = false
auto-update-channel = tip
mouse-scroll-multiplier = 1
font-feature = -dlig
font-feature = -liga
font-feature = -calt
working-directory = home

